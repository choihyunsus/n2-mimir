{
  "name": "n2-mimir",
  "version": "3.0.0",
  "description": "Experience learning engine — memories become experience, experience changes behavior",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "dist/**/*.d.cts",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-DAEBUNG",
    "LICENSE-ATOM-OF-THOUGHTS",
    "THIRD-PARTY-NOTICES"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      },
      "require": {
        "types": "./dist/store/index.d.cts",
        "default": "./dist/store/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "rimraf": "^6.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "ai",
    "agent",
    "experience",
    "learning",
    "sqlite",
    "n2"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/choihyunsus/n2-mimir"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
