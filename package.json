{
  "name": "n2-mimir-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "n2-Mímir — AI Experience Learning Engine",
  "workspaces": [
    "packages/mimir"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/mimir",
    "build:ts": "npm run build --workspace=packages/mimir",
    "build:native": "node scripts/build-native.cjs",
    "build:rust": "npm run build:native",
    "typecheck": "npm run typecheck --workspace=packages/mimir",
    "test:ts": "npm test --workspace=packages/mimir",
    "test:rust": "cargo +1.98.0 test --locked --manifest-path packages/core/Cargo.toml --jobs 2",
    "test": "npm run typecheck && npm run test:ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.18.0"
  }
}
